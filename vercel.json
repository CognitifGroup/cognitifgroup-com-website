{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "petalyx.cognitifgroup.com"
        }
      ],
      "destination": "/pages/demo.html"
    },
    {
      "source": "/:page.html",
      "destination": "/pages/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/demo/petalyx/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://www.cognitifgroup.com https://cognitifgroup.com https://petalyx.cognitifgroup.com"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
